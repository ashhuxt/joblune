# Database
DB_URL=jdbc:postgresql://localhost:5432/joblune
DB_USERNAME=joblune
DB_PASSWORD=joblune

# JWT (use a long random string in production, e.g. `openssl rand -base64 48`)
JWT_SECRET=change-this-to-a-long-random-secret-in-production-min-256-bits
JWT_ACCESS_EXP=900000
JWT_REFRESH_EXP=604800000

# CORS - comma separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary (free tier - https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=8080
DDL_AUTO=update
